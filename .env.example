# Firma la cookie de sesión del admin. No es la contraseña de acceso.
ADMIN_SECRET=cambia-este-secreto-en-produccion

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Cifrado AES-256-GCM de dirección, descripción, extras e imágenes.
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Resend (https://resend.com/api-keys) — formulario de contacto
RESEND_API_KEY=
# Producción: dominio verificado en Resend, p. ej. Corral Business <gestion.inmuebles@corralbusiness.com>
# Pruebas: Corral Business <onboarding@resend.dev> (solo envía al email de tu cuenta Resend)
RESEND_FROM=Corral Business <onboarding@resend.dev>
CONTACT_TO=gestion.inmuebles@corralbusiness.com
