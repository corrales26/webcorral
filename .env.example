# Firma la cookie de sesión del admin. No es la contraseña de acceso.
ADMIN_SECRET=cambia-este-secreto-en-produccion

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Cifrado AES-256-GCM de dirección, descripción, extras e imágenes.
